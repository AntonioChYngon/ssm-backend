PORT=3001
NODE_ENV=development
# Origen permitido para CORS (el frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# MariaDB: base creada con db/ssm_mariadb.sql y usuario de db/ssm_usuario_app.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=ssm_app
DB_PASSWORD=pon-aqui-la-contrasena-de-ssm_app
DB_NAME=ssm
# Solo para Podman (compose.yaml): contraseña de root del contenedor de MariaDB
DB_ROOT_PASSWORD=pon-aqui-otra-contrasena

# JWT: frase larga y aleatoria (40+ caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h

# URL pública del frontend (enlaces en los correos)
FRONTEND_URL=http://localhost:3000

# Correo. En desarrollo: Mailpit (podman compose up -d correo) y bandeja en http://localhost:8025
# Si dejas SMTP_HOST vacío, los correos solo se muestran en la consola del backend.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SSM FES Acatlán <no-responder@acatlan.unam.mx>

# HU-18 · Carpetas de evidencias de cada ciclo (/Evidencias/[Licenciatura]/[20XX-20XX]/).
# "local" las crea en disco dentro de CARPETAS_DIR. Google Drive se activará con "drive" cuando haya cuenta de servicio.
CARPETAS_PROVEEDOR=local
CARPETAS_DIR=storage

# Bloque Informe (HU-07) · Evidencias: peso máximo por archivo y programa de LibreOffice para convertir a PDF.
# En Windows sin LibreOffice la conversión responde 503 y la pantalla ofrece agregar un enlace.
# Ejemplo en Windows: SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
EVIDENCIA_MAX_MB=15
SOFFICE_BIN=soffice

# Dominios aceptados. Deben coincidir con el CHECK de la tabla usuario.
DOMINIOS_PERMITIDOS=acatlan.unam.mx,pcpuma.acatlan.unam.mx

# Usuarios de prueba (npm run seed). Contraseñas: 8+ caracteres, una mayúscula y un número.
SEED_ADMIN_CORREO=admin.ssm@acatlan.unam.mx
SEED_ADMIN_PASSWORD=MeGustaElPolloAsado2026
# Captura de Actuaría: correo real de su coordinación (Catálogos.xlsx). Las pruebas e2e inician sesión con esta cuenta.
SEED_CAPTURA_CORREO=actuaria@acatlan.unam.mx
SEED_CAPTURA_PASSWORD=CambiaEsta2026
# Cuentas Captura de las demás coordinaciones (correos de Catálogos.xlsx). Todas con la misma contraseña inicial,
# marcada como temporal: al primer inicio de sesión el sistema obliga a cambiarla.
SEED_CUENTAS_COORDINACIONES=false
SEED_CUENTAS_PASSWORD=
# Carga db/datos_desarrollo.sql (planes y avances ficticios). Solo en desarrollo y pruebas.
SEED_DATOS_DESARROLLO=true
