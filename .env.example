PORT=3001
NODE_ENV=development
# Origen permitido para CORS (el frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=ssm
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=ssm
# Solo en desarrollo: crea/actualiza tablas a partir de las entidades. En producción usar migraciones.
DB_SYNC=true

# JWT
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Dominios de correo aceptados (separados por coma)
DOMINIOS_PERMITIDOS=acatlan.unam.mx,unam.mx

# Evidencias
UPLOAD_DIR=./storage/evidencias
MAX_UPLOAD_MB=20
# Binario de LibreOffice para convertir Word/Excel/PowerPoint/imágenes a PDF
SOFFICE_BIN=soffice

# Días de anticipación para avisos de hitos (pendiente de confirmar con el cliente: naturales o hábiles)
DIAS_AVISO_HITO=7

# Solo para podman-compose (contenedor de MariaDB)
DB_ROOT_PASSWORD=cambia-esta-contrasena-root

# Carga inicial (npm run seed)
SEED_ADMIN_CORREO=admin.ssm@acatlan.unam.mx
SEED_ADMIN_PASSWORD=CambiaEsta2026
